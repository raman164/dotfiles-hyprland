{
    "include": "~/.config/waybar/themes/unique/modules",
    "layer": "top",
    "position": "top",
    "height": 36,
    "margin": "8 8 0 8",
    "spacing": 4,
    "modules-left": [
        "clock",
        "custom/space",
        "ext/workspaces"
    ],
    // ext/workspaces activates workspaces over the ext-workspace-v1 wayland
    // protocol. hyprland/workspaces sends the legacy string "dispatch workspace N"
    // over Hyprland's socket, which the lua config provider rejects as invalid
    // lua -- so clicking a number did nothing. Same CSS selectors as before.
    "ext/workspaces": {
        "on-click": "activate",
        "sort-by-id": true
    },

    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "tray",
        "group/system",
        "custom/space",
        "custom/power"
    ],
    "group/system": {
        "orientation": "horizontal",
        "modules": [ "custom/updater", "network", "bluetooth", "pulseaudio", "custom/power-mode", "battery" ]
    },
}
