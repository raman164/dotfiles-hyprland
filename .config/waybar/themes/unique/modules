{
    "hyprland/window": {
        "max-length": 64,
        "format": "{}"
    },

    "network": {
        "on-click": "~/.config/hypr/scripts/wifi-menu.sh",
        "format": "{icon}",
        "format-icons": [
            "󰤠", "󰤢", "󰤥", "󰤨" 
        ],
        "format-disconnected": "󰤭",
        "format-wifi": "{icon}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀 (no IP)",
        "tooltip-format-ethernet": "{ifname} (ethernet)",
        "tooltip-format-disconnected": "Disconnected"
    },

    "custom/updater":{
        "format": "  {}",
        "exec": "~/.config/waybar/themes/unique/checkforupdates",
        "return-type": "json",
        "exec-if": "[[ $(checkupdates | wc -l) ]]", "interval": 15, "on-click": "foot -T update yay -Syu || paru -Syu && notify-send 'The system has been updated'",
    },


    "bluetooth": {
        "format": "{icon}",
        "format-icons": "󰂯",
        "format-connected": "󰂯",
        "format-disconnected": "󰂲",
        "format-disabled": "󰂲",
        "tooltip-format": "Disconnected (on)",
        "tooltip-format-disabled": "Disconnected (off)",
        "tooltip-format-connected": "{device_alias} ({device_battery_percentage}%)",
        "tooltip-format-enumerate-connected": "{device_alias} ({device_battery_percentage}%)",
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰖁",
        "format-icons": {
            "headphones": "",
            "headset": "󱡏",
            "default": [
                "󰝟",
                "󱄡",
                "󰖀",
                "󰕾"
            ]
        },
        "tooltip-format": "Volume ({volume}%)"
    },

    "battery": {
        "format": "{icon}",
        "format-icons": [
            "󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"
        ],
        "format-charging": "󰂄",
        "format-full": "󱟢",
        "format-warning": "󰂃",
        "tooltip": true,
        "tooltip-format": "Discharging ({capacity}%)",
        "tooltip-format-charging": "Charging ({capacity}%)",
        "tooltip-format-full": "Full ({capacity}%)"
    },

    "custom/space": {
        "format": " ",
        "tooltip": false
    },

    "clock": {
        "format": "{:%I:%M %p}",
        "tooltip": true,
        "tooltip-format": "<big>{:%e %A}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
          "mode": "month",
          "mode-mon-col": 2,
          "format": {
            "today": "<span foreground='#89b4fa' font_weight='bold' underline='single'>{}</span>"
            },
        },
    },

    "tray": {
        "icon-size": 20,
        "spacing": 16
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip": true,
        "tooltip-format": "Power menu (wlogout)",
    },

    "backlight": {
        "format": "{icon}",
        "format-icons": ["󰃞", "󰃝", "󰃟", "󰃠"],
        "interval": 2,
        "on-scroll-up": "brightnessctl s +5%",
        "on-scroll-down": "brightnessctl s 5%-",
        "tooltip": true,
        "tooltip-format": "Current brightness: {percent}%"
    },

    "custom/power-mode": {
        "format": "{}",
        "exec": "~/.config/waybar/scripts/power-mode-toggle.sh",
        "return-type": "json",
        "interval": 2,
    }
}
